# --- PRODUCTION (Railway / any cloud host) ---
# Get a free key at https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_key_here

# --- LOCAL DEVELOPMENT (no key needed) ---
# If GROQ_API_KEY is not set, the app falls back to Ollama automatically.
# Make sure Ollama is running: ollama serve
# And you have a model pulled: ollama pull llama3.2
#
# You can also pick the model from the app itself: Settings → Local AI Model
# (llama3.2, mistral, phi3:mini, qwen2.5:7b, gemma2:9b). That choice is saved
# per-profile and overrides this env var. Pull whichever model you pick first.
#
# Optional overrides (used only if no model is selected in Settings):
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1
